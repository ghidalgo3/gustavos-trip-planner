                    "researchedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "locationSuggestion": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "venueName",
                    "geometry",
                    "source",
                    "retrievedAt"
                  ],
                  "properties": {
                    "venueName": {
                      "type": "string"

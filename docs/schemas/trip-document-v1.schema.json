{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghidalgo3.github.io/gustavos-trip-planner/schemas/trip-document-v1.schema.json",
  "title": "Trip document version 1",
  "description": "Portable trip document whose itinerary is one calendar of typed events and unscheduled tasks, including activities, transportation, city visits, and lodging stays. Details and timing belong to each item. API routes, assessments, and response bodies are excluded.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "revision",
    "createdAt",
    "updatedAt",
    "originPlaceId",
    "people",
    "places",
    "itinerary",
    "preferences"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "originPlaceId": {
      "type": "string"
    },
    "people": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/person"
      }
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/place"
      }
    },
    "itinerary": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/calendarItem"
          }
        }
      },
      "additionalProperties": false
    },
    "preferences": {
      "type": "object",
      "required": [
        "constraints",
        "activities",
        "destinations",
        "groups",
        "flightChoices"
      ],
      "properties": {
        "constraints": {
          "type": "object"
        },
        "activities": {
          "type": "object",
          "properties": {
            "etag": {
              "type": "string",
              "pattern": "^[!#-~\\u0080-\\u00ff]+$"
            },
            "contextVersion": {
              "type": "string"
            },
            "version": {
              "type": "integer"
            }
          }
        },
        "destinations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "destinationId",
              "constraints",
              "activities",
              "schedule"
            ],
            "properties": {
              "destinationId": {
                "type": "string"
              },
              "constraints": {
                "type": "object"
              },
              "activities": {
                "type": "object",
                "properties": {
                  "etag": {
                    "type": "string",
                    "pattern": "^[!#-~\\u0080-\\u00ff]+$"
                  },
                  "contextVersion": {
                    "type": "string"
                  },
                  "version": {
                    "type": "integer"
                  }
                }
              },
              "schedule": {
                "type": "object",
                "properties": {
                  "etag": {
                    "type": "string",
                    "pattern": "^[!#-~\\u0080-\\u00ff]+$"
                  },
                  "contextVersion": {
                    "type": "string"
                  },
                  "version": {
                    "type": "integer"
                  },
                  "days": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "maxLength": 200,
                          "description": "Optional name for this destination's local day; does not constrain scheduling."
                        }
                      }
                    }
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "flightChoicesEtag": {
                "type": "string",
                "pattern": "^[!#-~\\u0080-\\u00ff]+$"
              },
              "bookingEtag": {
                "type": "string",
                "pattern": "^[!#-~\\u0080-\\u00ff]+$"
              },
              "memberEtags": {
                "type": "object",
                "propertyNames": {
                  "format": "uuid"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[!#-~\\u0080-\\u00ff]+$"
                }
              },
              "booking": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          }
        },
        "flightChoices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "journeys": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "legIndex",
                    "details"
                  ],
                  "properties": {
                    "legIndex": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "details": {
                      "type": "object"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "flightPlanningEtag": {
          "type": "string",
          "pattern": "^[!#-~\\u0080-\\u00ff]+$"
        }
      },
      "additionalProperties": false
    },
    "etag": {
      "type": "string",
      "pattern": "^[!#-~\\u0080-\\u00ff]+$"
    },
    "canPlan": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "person": {
      "type": "object",
      "required": [
        "id",
        "name",
        "role",
        "isOwner",
        "homeCityName"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "enum": [
            "Planner",
            "Traveller"
          ]
        },
        "isOwner": {
          "type": "boolean"
        },
        "homeCityName": {
          "type": [
            "string",
            "null"
          ]
        },
        "etag": {
          "type": "string",
          "pattern": "^[!#-~\\u0080-\\u00ff]+$"
        },
        "contextVersion": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "place": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "Place",
            "Airport",
            "LodgingBusiness"
          ]
        },
        "name": {
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "Point"
                },
                "coordinates": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "timeZone": {
          "type": "string"
        },
        "iataCode": {
          "type": "string"
        },
        "address": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "destinationId": {
          "type": "string"
        },
        "countryCode": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        },
        "etag": {
          "type": "string",
          "pattern": "^[!#-~\\u0080-\\u00ff]+$"
        },
        "activitiesEtag": {
          "type": "string",
          "pattern": "^[!#-~\\u0080-\\u00ff]+$"
        },
        "contextVersion": {
          "type": "string"
        },
        "hotelId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "airportId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "userId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "calendarItem": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",

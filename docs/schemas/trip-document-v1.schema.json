                            "null"
                          ]
                        }
                      },
                      "additionalProperties": false
                    },
                    "researchedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "costEvidence": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "notes",
                    "source",
                    "researchedAt"
                  ],
                  "properties": {

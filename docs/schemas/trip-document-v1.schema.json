        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "enum": [
            "Planner",
            "Traveller"
          ]
        },
        "isOwner": {
          "type": "boolean"
        },
        "homeCityName": {
          "type": [
            "string",
            "null"
          ]
        },
        "etag": {
          "type": "string",
          "pattern": "^[!#-~\\u0080-\\u00ff]+$"
        },
        "contextVersion": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "place": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "Place",
            "Airport",
            "LodgingBusiness"
          ]
        },
        "name": {
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "Point"
                },
                "coordinates": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "timeZone": {
          "type": "string"
        },
        "iataCode": {
          "type": "string"
        },
        "address": {
          "type": "object"
        },
        "destinationId": {
          "type": "string"
        },
        "countryCode": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        },
        "etag": {
          "type": "string",
          "pattern": "^[!#-~\\u0080-\\u00ff]+$"
        },
        "activitiesEtag": {
          "type": "string",
          "pattern": "^[!#-~\\u0080-\\u00ff]+$"
        },
        "contextVersion": {
          "type": "string"
        }
      },
      "additionalProperties": false

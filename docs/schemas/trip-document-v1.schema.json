              "format": "uuid"
            },
            "destinationId": {
              "type": "string"
            },
            "description": {
              "type": "string",
              "maxLength": 10000,
              "description": "What the activity itself is and what to do there."
            },
            "notes": {
              "type": "string",
              "maxLength": 10000,
              "description": "Planner-written scheduling details, reminders, and other related information; does not enforce scheduling rules."
            },
            "cost": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "amount",
                    "currency",
                    "basis"
                  ],
                  "properties": {
                    "amount": {
                      "type": "number",
                      "minimum": 0
                    },
                    "currency": {
                      "type": "string",
                      "pattern": "^[A-Za-z]{3}$"
                    },
                    "basis": {
                      "enum": [
                        "perPerson",
                        "total"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "state": {
              "enum": [

#!/usr/bin/env zsh
set -euo pipefail

RESOURCE_GROUP="${RESOURCE_GROUP:-rg-tripplanner-dev}"
SUBSCRIPTION="${SUBSCRIPTION:-Gustavo Hidalgo personal subscription}"
INFRA_DEPLOYMENT_NAME="${INFRA_DEPLOYMENT_NAME:-tripplanner-infra}"

usage() {
  cat <<'USAGE'
Usage: scripts/secrets COMMAND [NAME]

Manage application credentials in the deployed Azure Key Vault.

Commands:
  --set-ignav    Prompt for and store the Ignav API key
  --set-openai    Store the developer eval runner OpenAI API key
  set-auth       Prompt for and store all Google and Microsoft credentials
  init-mcp       Generate the persistent MCP OAuth signing/encryption certificate if missing
  set NAME       Prompt for and rotate one credential
  status         Show which credentials exist without displaying values
  help           Show this help

Names: google-client-id, google-client-secret, microsoft-client-id,
microsoft-client-secret, ignav-api-key, openai-api-key, mcp-signing-certificate.

Environment overrides: RESOURCE_GROUP, SUBSCRIPTION, INFRA_DEPLOYMENT_NAME,
EXPECTED_TENANT_ID.
USAGE
}

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
log() { printf '\n==> %s\n' "$*"; }

COMMAND="${1:-help}"
[[ $# -gt 0 ]] && shift

if [[ "$COMMAND" == --set-ignav || "$COMMAND" == set-ignav ]]; then
  COMMAND=set
  set -- ignav-api-key "$@"
fi
if [[ "$COMMAND" == --set-openai || "$COMMAND" == set-openai ]]; then
  COMMAND=set
  set -- openai-api-key "$@"
fi

case "$COMMAND" in
  set-auth|set|status|init-mcp) ;;
  help|-h|--help) usage; exit 0 ;;
  *) usage >&2; die "unknown command: $COMMAND" ;;
esac

REPO_ROOT="${0:A:h:h}"
cd "$REPO_ROOT"

command -v az >/dev/null 2>&1 || die "Azure CLI is required; run scripts/setup"
az account show >/dev/null 2>&1 || die "not signed in to Azure; run: az login"
az account set --subscription "$SUBSCRIPTION"

EXPECTED_TENANT_ID="${EXPECTED_TENANT_ID:-8ac19fe6-f2db-412e-9750-97a9772a6786}"
ACTUAL_TENANT_ID="$(az account show --query tenantId -o tsv)"
[[ "$ACTUAL_TENANT_ID" == "$EXPECTED_TENANT_ID" ]] || die \
  "subscription is in tenant $ACTUAL_TENANT_ID, expected personal tenant $EXPECTED_TENANT_ID"

read_output() {
  az deployment group show \
    --name "$INFRA_DEPLOYMENT_NAME" \
    --resource-group "$RESOURCE_GROUP" \
    --query "properties.outputs.$1.value" -o tsv
}

az deployment group show \
  --name "$INFRA_DEPLOYMENT_NAME" \
  --resource-group "$RESOURCE_GROUP" \
  --output none 2>/dev/null || die \
  "infrastructure deployment '$INFRA_DEPLOYMENT_NAME' was not found; run scripts/buildout first"

KEY_VAULT_NAME="$(read_output keyVaultName)" || die \
  "could not read the Key Vault name from infrastructure deployment '$INFRA_DEPLOYMENT_NAME'"
[[ -n "$KEY_VAULT_NAME" ]] || die \
  "infrastructure deployment '$INFRA_DEPLOYMENT_NAME' has no keyVaultName output; run scripts/buildout with infra/main.bicep"

valid_name() {
  case "$1" in
    google-client-id|google-client-secret|microsoft-client-id|microsoft-client-secret|ignav-api-key|openai-api-key|mcp-signing-certificate) return 0 ;;
    *) return 1 ;;
  esac
}

store_secret() {
  local name="$1"
  local value="$2"
  [[ -n "$value" ]] || die "$name cannot be empty"
  az keyvault secret set \
    --vault-name "$KEY_VAULT_NAME" \
    --name "$name" \
    --value "$value" \
    --output none
}

refresh_references() {
  local web_app_name web_app_id
  web_app_name="$(read_output webAppName)"
  web_app_id="$(az webapp show --resource-group "$RESOURCE_GROUP" --name "$web_app_name" --query id -o tsv)"
  if ! az rest \
    --method post \
    --uri "https://management.azure.com${web_app_id}/config/configreferences/appsettings/refresh?api-version=2022-03-01" \
    --output none; then
    printf 'warning: credentials were stored, but Key Vault references were not refreshed; the next release will refresh them\n' >&2
  fi
}

case "$COMMAND" in
  init-mcp)
    [[ $# -eq 0 ]] || die "init-mcp does not accept arguments"
    existing_names=("${(@f)$(az keyvault secret list --vault-name "$KEY_VAULT_NAME" --query '[].name' -o tsv)}")
    if (( ${existing_names[(Ie)mcp-signing-certificate]} )); then
      printf 'MCP certificate already exists; leaving the current key unchanged.\n'
      exit 0
    fi
    command -v openssl >/dev/null 2>&1 || die "OpenSSL is required to generate the MCP certificate"
    umask 077
    mcp_temp="$(mktemp -d "${TMPDIR:-/tmp}/tripplanner-mcp.XXXXXXXX")"
    trap 'rm -f "$mcp_temp/key.pem" "$mcp_temp/cert.pem" "$mcp_temp/cert.pfx" "$mcp_temp/cert.base64"; rmdir "$mcp_temp"' EXIT
    openssl req -x509 -newkey rsa:3072 -nodes -days 730 \
      -subj '/CN=TripPlanner MCP OAuth' \
      -addext 'keyUsage=digitalSignature,keyEncipherment' \
      -keyout "$mcp_temp/key.pem" -out "$mcp_temp/cert.pem" 2>/dev/null
    openssl pkcs12 -export -inkey "$mcp_temp/key.pem" -in "$mcp_temp/cert.pem" \
      -out "$mcp_temp/cert.pfx" -passout pass:
    openssl base64 -A -in "$mcp_temp/cert.pfx" -out "$mcp_temp/cert.base64"
    az keyvault secret set --vault-name "$KEY_VAULT_NAME" --name mcp-signing-certificate \
      --file "$mcp_temp/cert.base64" --encoding utf-8 --output none
    refresh_references
    printf 'Created MCP OAuth certificate in %s. Expires in 730 days.\n' "$KEY_VAULT_NAME"
    ;;
  status)
    existing_names=("${(@f)$(az keyvault secret list --vault-name "$KEY_VAULT_NAME" --query '[].name' -o tsv)}")
    printf 'Application credentials in %s:\n' "$KEY_VAULT_NAME"
    for name in google-client-id google-client-secret microsoft-client-id microsoft-client-secret ignav-api-key openai-api-key mcp-signing-certificate; do
      if (( ${existing_names[(Ie)$name]} )); then
        printf '  %-22s present\n' "$name"
      else
        printf '  %-22s missing\n' "$name"
      fi
    done
    ;;
  set)
    [[ $# -eq 1 ]] || die "set requires exactly one credential name"
    name="$1"
    valid_name "$name" || die "unsupported credential name: $name"
    if [[ "$name" == *-secret || "$name" == *-key || "$name" == *-certificate ]]; then
      read -rs "value?Enter $name: "
      printf '\n'
    else
      read -r "value?Enter $name: "
    fi
    store_secret "$name" "$value"
    unset value
    refresh_references
    printf 'Stored %s in %s.\n' "$name" "$KEY_VAULT_NAME"
    ;;
  set-auth)
    [[ $# -eq 0 ]] || die "set-auth does not accept arguments"
    read -r "google_client_id?Google client ID: "
    read -rs "google_client_secret?Google client secret: "
    printf '\n'
    read -r "microsoft_client_id?Microsoft application (client) ID: "
    read -rs "microsoft_client_secret?Microsoft client secret: "
    printf '\n'

    log "Storing authentication credentials in $KEY_VAULT_NAME"
    store_secret google-client-id "$google_client_id"
    store_secret google-client-secret "$google_client_secret"
    store_secret microsoft-client-id "$microsoft_client_id"
    store_secret microsoft-client-secret "$microsoft_client_secret"
    unset google_client_id google_client_secret microsoft_client_id microsoft_client_secret
    refresh_references
    printf 'Authentication credentials are stored. Run scripts/release to enable sign-in.\n'
    ;;
esac

#!/usr/bin/env zsh
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: scripts/install

Restore the repository's .NET tools and packages and install its web dependencies.
USAGE
}

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
log() { printf '\n==> %s\n' "$*"; }

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  '') ;;
  *) usage >&2; die "unknown argument: $1" ;;
esac

REPO_ROOT="${0:A:h:h}"
cd "$REPO_ROOT"

for command_name in corepack dotnet; do
  command -v "$command_name" >/dev/null 2>&1 || die "$command_name is required; run scripts/setup"
done

log "Restoring .NET tools and packages"
dotnet tool restore
dotnet restore GustavoTripPlanner.sln

log "Installing web dependencies"
(cd src/TripPlanner.Web && CI=true corepack pnpm install --frozen-lockfile)

printf '\nProject dependencies installed.\n'

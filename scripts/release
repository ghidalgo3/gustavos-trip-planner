#!/usr/bin/env zsh
set -euo pipefail

unset NODE_OPTIONS

RESOURCE_GROUP="${RESOURCE_GROUP:-rg-tripplanner-dev}"
SUBSCRIPTION="${SUBSCRIPTION:-Gustavo Hidalgo personal subscription}"
NAME_PREFIX="${NAME_PREFIX:-tripplanner}"
IMAGE_NAME="${IMAGE_NAME:-tripplanner-api}"
INFRA_DEPLOYMENT_NAME="${INFRA_DEPLOYMENT_NAME:-tripplanner-infra}"
CONFIG_DEPLOYMENT_NAME="${CONFIG_DEPLOYMENT_NAME:-tripplanner-release}"
RELEASE_SKIP_TESTS=false
RELEASE_TARGET=release:pipeline

usage() {
  cat <<'USAGE'
Usage: scripts/release [options]

Build, configure, deploy, and verify the application.
Run scripts/buildout before the first release and after infrastructure changes.
All changes must be committed, including untracked files.
Successful deployments create a local annotated YYYY.MM.DD.N tag (New York date,
daily sequence starting at 1). Fetch shared tags before releasing; tags are not pushed.

Options:
  -g, --resource-group NAME   Resource group (default: rg-tripplanner-dev)
  -s, --subscription ID|NAME  Azure subscription
  -p, --name-prefix PREFIX    Resource name prefix (default: tripplanner)
      --check                 Run checks/builds without publishing, deploying, or tagging
      --skip-tests            Skip formatting, API tests, and web lint/tests
  -h, --help                  Show this help

Environment overrides: RESOURCE_GROUP, SUBSCRIPTION, NAME_PREFIX, IMAGE_NAME,
INFRA_DEPLOYMENT_NAME, CONFIG_DEPLOYMENT_NAME, EXPECTED_TENANT_ID,
NUGET_SOURCE, HEALTH_ATTEMPTS, HEALTH_INTERVAL, RELEASE_CONCURRENCY (default: 4).
MCP_REDIRECT_URI overrides the exact ChatGPT OAuth callback URL.

All four authentication credentials must be stored in the deployed Key Vault
with scripts/secrets set-auth and the Ignav API key with scripts/secrets --set-ignav
before releasing.
USAGE
}

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
log() { printf '\n==> %s\n' "$*"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    -g|--resource-group) RESOURCE_GROUP="${2:?missing value for $1}"; shift 2 ;;
    -s|--subscription) SUBSCRIPTION="${2:?missing value for $1}"; shift 2 ;;
    -p|--name-prefix) NAME_PREFIX="${2:?missing value for $1}"; shift 2 ;;
    --check) RELEASE_TARGET=release:check-pipeline; shift ;;
    --skip-tests) RELEASE_SKIP_TESTS=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; die "unknown argument: $1" ;;
  esac
done

REPO_ROOT="${0:A:h:h}"
cd "$REPO_ROOT"

command -v git >/dev/null 2>&1 || die "git is required; run scripts/setup"
source "$REPO_ROOT/scripts/release-tasks/git.zsh"
require_release_checkout
RELEASE_COMMIT="$(git rev-parse --verify HEAD)"
export RELEASE_COMMIT

for command_name in task az corepack curl docker dotnet node shasum gzip; do
  command -v "$command_name" >/dev/null 2>&1 || die "$command_name is required; run scripts/setup"
done

export RESOURCE_GROUP SUBSCRIPTION NAME_PREFIX IMAGE_NAME
export INFRA_DEPLOYMENT_NAME CONFIG_DEPLOYMENT_NAME RELEASE_SKIP_TESTS

# Concurrent releases share dist, .NET outputs, and the local image tag.
RELEASE_LOCK_DIR="$REPO_ROOT/.task/release.lock"
mkdir -p "${RELEASE_LOCK_DIR:h}"
mkdir "$RELEASE_LOCK_DIR" 2>/dev/null || die \
  "another release or release check is already running; wait for it to finish (lock: $RELEASE_LOCK_DIR)"
RELEASE_STATE_DIR=""
cleanup() {
  if [[ -n "$RELEASE_STATE_DIR" ]]; then
    rm -rf -- "$RELEASE_STATE_DIR"
  fi
  rm -rf -- "$RELEASE_LOCK_DIR"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
print -r -- "$$" > "$RELEASE_LOCK_DIR/pid"

if [[ "$RELEASE_TARGET" == release:pipeline ]]; then
  # Validate the tag identity before publishing anything.
  git var GIT_COMMITTER_IDENT >/dev/null
  RELEASE_VERSION="$(next_release_version "$(TZ=America/New_York date +%Y.%m.%d)")"
  log "Releasing $RELEASE_VERSION from $RELEASE_COMMIT"
fi

RELEASE_STATE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/tripplanner-release.XXXXXX")"
export RELEASE_STATE_DIR

# Task cancels remaining preparation work when a prerequisite fails.
# The per-invocation directory is removed after all stages have stopped.
task --taskfile "$REPO_ROOT/Taskfile.yml" \
  --concurrency "${RELEASE_CONCURRENCY:-4}" "$RELEASE_TARGET"

require_release_checkout "$RELEASE_COMMIT"
if [[ "$RELEASE_TARGET" == release:pipeline ]]; then
  git tag -a "$RELEASE_VERSION" "$RELEASE_COMMIT" -m "Release $RELEASE_VERSION" \
    || die "deployment verified, but creating tag $RELEASE_VERSION failed; resolve the Git error before recording the release"
  log "Created release tag $RELEASE_VERSION"
  print -r -- "Move CHANGELOG.md Unreleased entries to ## $RELEASE_VERSION, keep an empty ## Unreleased, and commit the changelog update separately."
fi

#!/usr/bin/env zsh
set -euo pipefail

CHECK_ONLY=false
CLOUD=false

usage() {
  cat <<'USAGE'
Usage: scripts/setup [--cloud] [--check]

Install the macOS toolchain or prepare the Linux x64 cloud toolchain.

Options:
  --cloud   Use the cloud machine's Docker, Node.js and Corepack, and install .NET
  --check   Report tool availability without installing or changing anything
  -h        Show this help
USAGE
}

die() { printf 'error: %s\n' "$*" >&2; exit 1; }
log() { printf '\n==> %s\n' "$*"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --cloud) CLOUD=true; shift ;;
    --check) CHECK_ONLY=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; die "unknown argument: $1" ;;
  esac
done

REPO_ROOT="${0:A:h:h}"
cd "$REPO_ROOT"

if [[ "$CLOUD" == true ]]; then
  [[ "$(uname -s)-$(uname -m)" == Linux-x86_64 ]] || die "cloud setup requires Linux x64"
  for command_name in docker node corepack curl sha512sum tar; do
    command -v "$command_name" >/dev/null 2>&1 || die "$command_name is required"
  done
  docker info >/dev/null 2>&1 || die "the Docker daemon is not running"
  docker compose version
  node --version
  source scripts/lib/cloud.zsh
  activate_cloud_environment
  if [[ "$CHECK_ONLY" == false ]]; then
    # The Linux runtime uses this profile directory for named mutexes.
    mkdir -p ~/.dotnet "$XDG_DATA_HOME"
    install_cloud_dotnet
  fi
  [[ -x "$DOTNET_ROOT/dotnet" ]] || die "run scripts/setup --cloud to install .NET"
  "$DOTNET_ROOT/dotnet" --version
  exit 0
fi

[[ "$(uname -s)" == "Darwin" ]] || die "use scripts/setup --cloud on the Linux cloud machine"
command -v brew >/dev/null 2>&1 || die \
  "Homebrew is required. Install it from https://brew.sh, then rerun this script."

report_tools() {
  local missing=false
  for command_name in az node corepack pnpm docker dotnet git curl task; do
    if command -v "$command_name" >/dev/null 2>&1; then
      printf '  %-10s %s\n' "$command_name" "$(command -v "$command_name")"
    else
      printf '  %-10s missing\n' "$command_name"
      missing=true
    fi
  done

  local postgres_client="$(brew --prefix libpq 2>/dev/null)/bin/psql"
  if command -v psql >/dev/null 2>&1; then
    printf '  %-10s %s\n' psql "$(command -v psql)"
  elif [[ -x "$postgres_client" ]]; then
    printf '  %-10s %s\n' psql "$postgres_client"
  else
    printf '  %-10s missing\n' psql
    missing=true
  fi

  if command -v docker >/dev/null 2>&1; then
    if docker info >/dev/null 2>&1; then
      printf '  %-10s running\n' daemon
    else
      printf '  %-10s not running (start Docker Desktop before local development or release)\n' daemon
    fi
  fi

  [[ "$missing" == false ]]
}

if [[ "$CHECK_ONLY" == true ]]; then
  log "Development toolchain"
  report_tools || exit 1
  exit 0
fi

log "Installing command-line tools"
brew install azure-cli corepack dotnet git libpq go-task

if ! brew list --cask docker-desktop >/dev/null 2>&1 \
  && [[ ! -d /Applications/Docker.app ]] \
  && [[ ! -d "$HOME/Applications/Docker.app" ]]; then
  log "Installing Docker Desktop"
  brew install --cask docker-desktop
fi

hash -r

log "Activating the repository's pinned pnpm release"
corepack enable pnpm
corepack install --global pnpm@11.19.0

log "Installing Azure Bicep CLI"
az bicep install

log "Installed development toolchain"
report_tools || die "one or more required commands are still unavailable; open a new shell and run scripts/setup --check"

if ! docker info >/dev/null 2>&1; then
  printf '\nDocker Desktop is installed but not running. Start it before running:\n'
  printf '  scripts/server\n'
  printf '  scripts/release\n'
fi

printf '\nSetup complete. Run scripts/install to install the project dependencies.\n'

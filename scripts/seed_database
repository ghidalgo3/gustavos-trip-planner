#!/usr/bin/env zsh
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: scripts/seed_database [--count COUNT] [USER_EMAIL]

Seed the local development database through the application's C# database services.
Start scripts/server and sign in at least once first. Requires the .NET 10 SDK.

Defaults to Trip Small, Trip Medium, and Trip Large. Use --count 1000 for 1,000
sample trips, cycling through those destination sets with numbered names.
Large trips include 15 activity ideas per destination. Reruns refresh visit dates
and fill in missing sample activities, including any deleted sample activities.
The first trip starts tomorrow. Each destination gets three nights, with one
day between trips.
With multiple users, supply the owner's email.
USAGE
}

if [[ "${1:-}" == '-h' || "${1:-}" == '--help' ]]; then
  usage
  exit 0
fi

REPO_ROOT="${0:A:h:h}"
cd "$REPO_ROOT"

command -v dotnet >/dev/null 2>&1 || {
  printf 'error: dotnet is required; run scripts/setup\n' >&2
  exit 1
}

exec dotnet run --project tools/TripPlanner.SeedDatabase --no-launch-profile -- "$@"

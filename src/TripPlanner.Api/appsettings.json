{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Planning": {
    "DatePairLimit": 40,
    "FareRequestLimit": 160,
    "WorkerConcurrency": 2
  },
  "ClientOrigins": [],
  "Mcp": {
    "AgentClients": [
      {
        "ClientId": "muse",
        "DisplayName": "Muse",
        "RedirectUris": ["https://agent.meta.ai/api/hatch/oauth/callback"]
      }
    ]
  },
  "AllowedHosts": "*",
  "Ignav": {
    "TimeoutSeconds": 480,
    "MaxConcurrentRequests": 2
  }
}

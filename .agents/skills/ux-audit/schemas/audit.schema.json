{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "skillVersion": {
      "type": "string",
      "minLength": 1
    },
    "metricsVersion": {
      "type": "integer"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "$ref": "#/definitions/metadata"
    },
    "scope": {
      "type": "object",
      "required": ["rules", "severity", "weights"],
      "properties": {
        "rules": {
          "type": "object"
        },
        "severity": {
          "type": "object"
        },
        "weights": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "journeys": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/journey"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "finding"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "positives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenarioId", "description", "evidence"],
        "properties": {
          "scenarioId": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "untested": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "comparison": {
      "type": ["object", "null"]
    },
    "responsiveComparison": {
      "type": ["object", "null"]
    }
  },
  "required": [
    "schemaVersion",
    "skillVersion",
    "metricsVersion",
    "generatedAt",
    "metadata",
    "scope",
    "journeys",
    "findings",
    "positives",
    "limitations",
    "untested",
    "comparison",
    "responsiveComparison"
  ],
  "additionalProperties": false,
  "definitions": {
    "platform": {
      "enum": ["desktop", "mobile-web"]
    },
    "viewport": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "browser",
        "browserVersion",
        "viewport",
        "touch",
        "touchGestures",
        "headed"
      ],
      "properties": {
        "browser": {
          "type": "string",
          "minLength": 1
        },
        "browserVersion": {
          "type": "string",
          "minLength": 1
        },
        "viewport": {
          "$ref": "#/definitions/viewport"
        },
        "touch": {
          "type": "boolean"
        },
        "touchGestures": {
          "type": "boolean"
        },
        "headed": {
          "type": "boolean"
        },
        "device": {
          "type": ["string", "null"]
        },
        "userAgent": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "required": [
        "appVersion",
        "platform",
        "origin",
        "fixture",
        "environment",
        "rulesFingerprint",
        "profileFingerprint",
        "projectValidatorsEnabled",
        "writable"
      ],
      "properties": {
        "appVersion": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "$ref": "#/definitions/platform"
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "fixture": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "$ref": "#/definitions/environment"
        },
        "rulesFingerprint": {
          "type": "string",
          "minLength": 1
        },
        "profileFingerprint": {
          "type": "string",
          "minLength": 1
        },
        "projectValidatorsEnabled": {
          "type": "boolean"
        },
        "writable": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "outcome": {
      "type": "object",
      "required": ["status", "reason", "evidence"],
      "properties": {
        "status": {
          "enum": ["success", "partial", "failure", "blocked"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "logicalActions",
        "tags",
        "input",
        "pageTransitions",
        "maxRouteDepth",
        "modalTransitions",
        "observedDecisionPoints",
        "observedMemoryDemands"
      ],
      "properties": {
        "logicalActions": {
          "type": "integer",
          "minimum": 0
        },
        "pageTransitions": {
          "type": "integer",
          "minimum": 0
        },
        "maxRouteDepth": {
          "type": "integer",
          "minimum": 0
        },
        "modalTransitions": {
          "type": "integer",
          "minimum": 0
        },
        "observedDecisionPoints": {
          "type": "integer",
          "minimum": 0
        },
        "observedMemoryDemands": {
          "type": "integer",
          "minimum": 0
        },
        "relevantAlternatives": {
          "type": "integer",
          "minimum": 0
        },
        "contextSwitches": {
          "type": "integer",
          "minimum": 0
        },
        "labeledStateTransitions": {
          "type": "integer",
          "minimum": 0
        },
        "charactersTyped": {
          "type": "integer",
          "minimum": 0
        },
        "recordedKeydowns": {
          "type": "integer",
          "minimum": 0
        },
        "keyboardActionsWithUnknownKeydowns": {
          "type": "integer",
          "minimum": 0
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "shortestVerifiedActions": {
          "type": ["number", "null"]
        },
        "excessActions": {
          "type": ["number", "null"]
        },
        "actionEfficiency": {
          "type": ["number", "null"]
        },
        "actionOverhead": {
          "type": ["number", "null"]
        }
      },
      "additionalProperties": true
    },
    "attempt": {
      "type": "object",
      "required": ["attempt", "kind", "outcome", "metrics", "log", "actions"],
      "properties": {
        "attempt": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["observed", "alternative"]
        },
        "outcome": {
          "$ref": "#/definitions/outcome"
        },
        "metrics": {
          "$ref": "#/definitions/metrics"
        },
        "log": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "before", "dispatched", "tags"],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "before": {
                "type": "string",
                "minLength": 1
              },
              "after": {
                "type": "string",
                "minLength": 1
              },
              "dispatched": {
                "type": "boolean"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/checkpoint"
          }
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": ["screenshot", "path"],
      "properties": {
        "screenshot": {
          "type": "string",
          "minLength": 1
        },
        "annotation": {
          "type": "string",
          "minLength": 1
        },
        "modal": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "ruleCheck": {
      "type": "object",
      "required": ["ruleId", "status", "coverage", "evidence"],
      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "untested",
            "disabled",
            "qualitative",
            "exception"
          ]
        },
        "coverage": {
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "journey": {
      "type": "object",
      "required": [
        "scenario",
        "persona",
        "outcome",
        "metrics",
        "attempts",
        "evidence",
        "ruleChecks"
      ],
      "properties": {
        "scenario": {
          "type": "object",
          "required": ["id", "version", "goal"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "goal": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "persona": {
          "type": "object",
          "required": ["id", "version", "familiarity"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "familiarity": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "outcome": {
          "$ref": "#/definitions/outcome"
        },
        "metrics": {
          "$ref": "#/definitions/metrics"
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/attempt"
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/evidence"
          }
        },
        "ruleChecks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ruleCheck"
          }
        }
      },
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "required": [
        "id",
        "goal",
        "status",
        "reason",
        "evidence",
        "actionCount",
        "findings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["success", "partial", "failure", "blocked", "skipped"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": ["string", "null"]
        },
        "actionCount": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "cognitive-load",
        "navigation",
        "action-count",
        "discoverability",
        "consistency",
        "design",
        "accessibility",
        "responsive"
      ]
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": ["desktop", "mobile-web"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "pass": {
      "type": "string",
      "minLength": 1
    },
    "threshold": {
      "type": "number"
    },
    "severity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "weight": {
      "type": "number",
      "minimum": 0
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "excludedScenarios": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "validator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "control"
            },
            "control": {
              "enum": [
                "search",
                "search-clear",
                "icon-button",
                "button",
                "interactive"
              ]
            },
            "check": {
              "enum": [
                "min-width",
                "min-height",
                "min-font",
                "width-at-least-height",
                "accessible-name"
              ]
            }
          },
          "required": ["kind", "control", "check"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "action-budget"
            }
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "script"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["kind", "path"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "id",
    "title",
    "description",
    "category",
    "instructions",
    "evidence",
    "pass",
    "severity"
  ],
  "additionalProperties": false
}

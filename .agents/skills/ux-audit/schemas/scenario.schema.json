{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "persona": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "setup": {
      "type": "string",
      "minLength": 1
    },
    "startPath": {
      "type": "string",
      "pattern": "^/(?!/)[^\\\\]*$"
    },
    "success": {
      "type": "string",
      "minLength": 1
    },
    "partial": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": ["desktop", "mobile-web"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "writes": {
      "type": "boolean"
    },
    "actionBudget": {
      "type": "object",
      "properties": {
        "desktop": {
          "type": "integer",
          "minimum": 0
        },
        "mobile-web": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "goal", "success"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "success": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "version",
    "goal",
    "persona",
    "setup",
    "startPath",
    "success"
  ],
  "additionalProperties": false
}
